<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="10dp"
    android:background="#EEEEEE">

    <TextView
        android:id="@+id/textIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ingredient_name"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textIngredientDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quantity_label"
        android:textSize="16sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/textIngredientCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/category_label"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textIngredientMinStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/minimum_stock_label"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textIngredientStockWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/low_stock"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/textIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/expiry_label"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/textIngredientExpiryWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/expiring_soon"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnEditIngredient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/delete"
            android:minHeight="48dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>