<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Recipe name -->

        <TextView
            android:id="@+id/textRecipeDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textRecipeDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe description"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <!-- Ingredients -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required Ingredients"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textRecipeDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="20dp" />

        <!-- Method -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation Method"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textRecipeDetailMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation method"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>